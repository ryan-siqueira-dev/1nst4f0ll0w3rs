{
  "manifest_version": 3,
  "name": "1nst4f0ll0w3rs",
  "version": "1.0.0",
  "description": "Compare seguidores e contas seguidas diretamente no Instagram, com captura e análise locais.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
